<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Sandlada.RopSharp</RootNamespace>
    <AssemblyName>Sandlada.RopSharp</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.0.1</PackageValidationBaselineVersion>
    <!-- The library has no runtime package dependencies; its only package (ILLink) is SDK-versioned and would
         make the lock file churn on every SDK update. Lock files are committed for the test/benchmark graphs. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <AnalysisMode>All</AnalysisMode>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Sandlada.RopSharp</PackageId>
    <Version>0.0.2</Version>
    <Authors>Sandlada</Authors>
    <Company>Sandlada</Company>
    <Product>Sandlada.RopSharp</Product>
    <Description>Production-grade railway-oriented programming (ROP) for modern C#: Result&lt;TOk,TErr&gt;, Option&lt;T&gt;, Either&lt;TLeft,TRight&gt;, structured RopError with categories, applicative validation, parsing, and cancellation-aware async combinators. Immutable structs, AOT friendly, zero reflection in hot paths.</Description>
    <PackageTags>rop;railway-oriented-programming;result;option;either;functional;validation;error-handling;async;cancellation;aot;csharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageReleaseNotes>See CHANGELOG.md [0.0.2] for migration from 0.0.1.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <RepositoryUrl>https://github.com/sandlada/RopSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://github.com/sandlada/RopSharp</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sandlada.RopSharp.Analyzers\Sandlada.RopSharp.Analyzers.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Analyzer</OutputItemType>
      <SetTargetFramework>TargetFramework=netstandard2.0</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Sandlada.RopSharp.Analyzers\bin\$(Configuration)\netstandard2.0\Sandlada.RopSharp.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Link="analyzers/dotnet/cs/Sandlada.RopSharp.Analyzers.dll" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sandlada.RopSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
